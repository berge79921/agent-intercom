<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>intercom-wake</string>
  <key>ProgramArguments</key><array><string>__WAKE_DIR__/wake-loop.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>__PATH__</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/intercom-wake-loop.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/intercom-wake-loop.err.log</string>
</dict></plist>
